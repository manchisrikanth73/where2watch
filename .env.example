# TMDb API — https://developer.themoviedb.org/  [REQUIRED]
TMDB_API_KEY=your_tmdb_api_key_here

# OpenAI API — https://platform.openai.com/  [OPTIONAL]
# When set: AI-generated captions via gpt-4o-mini (~$0.01/month)
# When absent: free template captions are used automatically
# OPENAI_API_KEY=your_openai_api_key_here

# Instagram Graph API (Phase 2)
INSTAGRAM_ACCESS_TOKEN=your_instagram_access_token_here
INSTAGRAM_USER_ID=your_instagram_business_user_id_here

# Imgur image hosting (Phase 2 — register free app at https://api.imgur.com/oauth2/addclient)
IMGUR_CLIENT_ID=your_imgur_client_id_here

# GitHub (auto-injected in Actions; only needed for local approval workflow testing)
# GITHUB_TOKEN=your_github_pat_here
# GITHUB_REPOSITORY=owner/repo
